# Copy this file to .env for local development. Replace every placeholder.
# Do not use the cloud migration URL as the local DATABASE_URL.
DATABASE_URL=postgresql://LOCAL_USER:LOCAL_PASSWORD@localhost:5432/LOCAL_DATABASE?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PORT=5000
# HOST is optional. Production defaults to 0.0.0.0; local development stays on loopback.
# HOST=0.0.0.0
# NODE_ENV=production

# Optional. Defaults to localhost:5173 and localhost:5176 in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5176

# Supply this only when intentionally applying migrations to the separate cloud database.
# npm run db:deploy requires this value and refuses loopback database hosts.
CLOUD_DATABASE_URL=postgresql://CLOUD_USER:CLOUD_PASSWORD@CLOUD_DATABASE_HOST:5432/CLOUD_DATABASE?sslmode=require

# Only needed when provisioning initial administrator accounts.
INITIAL_ADMIN_1_NAME=REPLACE_WITH_ADMIN_1_NAME
INITIAL_ADMIN_1_EMAIL=admin1@example.invalid
INITIAL_ADMIN_1_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
INITIAL_ADMIN_2_NAME=REPLACE_WITH_ADMIN_2_NAME
INITIAL_ADMIN_2_EMAIL=admin2@example.invalid
INITIAL_ADMIN_2_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD
INITIAL_ADMIN_3_NAME=REPLACE_WITH_ADMIN_3_NAME
INITIAL_ADMIN_3_EMAIL=admin3@example.invalid
INITIAL_ADMIN_3_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_STRONG_PASSWORD
